{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verification",
  "title": "출처 검증 결과 (verified.json 항목의 verification)",
  "type": "object",
  "required": ["checked_at", "checked_by", "verified", "needs_agent", "notes"],
  "additionalProperties": false,
  "properties": {
    "checked_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "checked_by": {"enum": ["script", "agent"]},
    "http_status": {"type": ["integer", "null"]},
    "final_url": {"type": ["string", "null"]},
    "url_ok": {"type": ["boolean", "null"]},
    "doi_ok": {"type": ["boolean", "null"], "description": "DOI 가 없으면 null"},
    "quote_match": {"enum": ["exact", "approx", "missing", "unchecked"]},
    "date_in_window": {"type": ["boolean", "null"], "description": "trigger 가 아니면 null"},
    "tier_expected": {"type": "integer", "minimum": 0, "maximum": 3},
    "tier_ok": {"type": "boolean"},
    "verified": {"type": "boolean"},
    "needs_agent": {"type": "boolean", "description": "스크립트가 판정하지 못해 verifier 에이전트가 직접 확인해야 함"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
