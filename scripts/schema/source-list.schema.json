{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-list",
  "title": "출처 목록 (sources.json, background.json, verified.json, background-verified.json)",
  "description": "리서치(①)·자료 보강(④) 단계의 산출물과, 출처 검증(②) 결과. 항목 하나가 출처 하나다.",
  "type": "object",
  "required": ["issue", "stage", "items"],
  "additionalProperties": false,
  "properties": {
    "issue": {"type": "string", "pattern": "^\\d{4}-W\\d{2}$"},
    "stage": {"enum": ["sources", "background", "verified"]},
    "items": {"type": "array", "items": {"$ref": "#/$defs/source"}}
  },
  "if": {"properties": {"stage": {"const": "verified"}}},
  "then": {"properties": {"items": {"items": {"required": ["verification"]}}}},
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "region", "kind", "role", "topic", "title", "publisher", "url", "published_at", "tier", "quote", "claims"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[gkabs]-\\d{2,3}$", "description": "g 글로벌 · k 국내 · a 학술 · b 배경 · s 장기 연속자료"},
        "region": {"enum": ["global", "korea"]},
        "kind": {"enum": ["news", "official", "paper", "preprint", "report", "dataset"]},
        "role": {"enum": ["trigger", "background", "series"]},
        "topic": {"type": "string", "minLength": 1, "maxLength": 40},
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1, "description": "발행 기관, 매체 또는 학술지"},
        "authors": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "개인은 'Family, Given', 기관은 이름 그대로"},
        "url": {"type": "string", "pattern": "^https?://"},
        "doi": {"type": "string", "pattern": "^10\\.\\d{4,9}/\\S+$"},
        "published_at": {"type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"},
        "version": {"type": "string", "description": "자료의 버전 (dataset)"},
        "peer_reviewed": {"type": "boolean"},
        "tier": {"type": "integer", "minimum": 0, "maximum": 3},
        "quote": {"type": "string", "minLength": 10, "maxLength": 600, "description": "원문에서 그대로 옮긴 1~2문장. 논문은 초록에서"},
        "claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "follow_up": {"type": "boolean"},
        "verification": {"$ref": "verification"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "paper"}}}, "then": {"required": ["doi", "authors", "peer_reviewed"], "properties": {"peer_reviewed": {"const": true}}}},
        {"if": {"properties": {"kind": {"const": "preprint"}}}, "then": {"required": ["authors", "peer_reviewed"], "properties": {"peer_reviewed": {"const": false}}}},
        {"if": {"properties": {"role": {"const": "trigger"}}}, "then": {"properties": {"id": {"pattern": "^[gka]-"}, "published_at": {"pattern": "^\\d{4}-\\d{2}-\\d{2}$"}}}},
        {"if": {"properties": {"role": {"const": "background"}}}, "then": {"properties": {"id": {"pattern": "^b-"}}}},
        {"if": {"properties": {"role": {"const": "series"}}}, "then": {"properties": {"id": {"pattern": "^s-"}, "kind": {"const": "dataset"}}}}
      ]
    }
  }
}
